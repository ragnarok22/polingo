{
  "name": "polingo",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "description": "Modern i18n library using .po/.mo files",
  "homepage": "https://github.com/ragnarok22/polingo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ragnarok22/polingo.git"
  },
  "bugs": {
    "url": "https://github.com/ragnarok22/polingo/issues"
  },
  "scripts": {
    "build": "pnpm turbo run build",
    "dev": "pnpm turbo run dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "pnpm turbo run test",
    "test:coverage": "pnpm turbo run test:coverage",
    "test:watch": "vitest",
    "lint": "pnpm turbo run lint",
    "lint:fix": "eslint \"packages/*/{src,test}/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"packages/**/*.{ts,json,md}\" \"docs/**/*.md\"",
    "typecheck": "pnpm turbo run typecheck",
    "examples:sync": "node ./scripts/sync-examples.mjs sync",
    "examples:check": "node ./scripts/sync-examples.mjs check",
    "examples:smoke": "pnpm examples:check && pnpm --dir examples/express install --lockfile=false --prefer-offline && pnpm --dir examples/express build && pnpm --dir examples/react-vite install --lockfile=false --prefer-offline && pnpm --dir examples/react-vite build",
    "security": "pnpm audit --prod --audit-level=moderate && pnpm exec lockfile-lint --type pnpm --path pnpm-lock.yaml --validate-https",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "lockfile-lint": "^5.0.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "turbo": "^2.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitepress": "2.0.0-alpha.12",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  }
}
